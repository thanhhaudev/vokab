<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App sandbox is intentionally disabled: vokab spawns the `agy` CLI via
	  Process and integrates with system Services, which an unsandboxed local
	  build handles without entitlement gymnastics. Sandboxing is future work.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
